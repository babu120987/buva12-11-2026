# Copy to .env and fill in.  Never commit .env to GitHub.
#   cp .env.example .env

# Port on this PC (Tailscale Funnel / NPM forward to it)
WEB_PORT=9090

# ---- database (used on first start; changing it later needs `docker compose down -v`) ----
DB_PASSWORD=change-this-to-a-long-random-password

# ---- admin panel (/admin) — the key you type to sign in ----
ADMIN_API_KEY=change-this-to-a-long-random-key

# ---- site address (Google sign-in returns here) ----
PUBLIC_SITE_URL=https://buva.shop

# ---- Razorpay (leave empty to offer cash on delivery only) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Google sign-in (until set, the "Continue with Google" button shows an error) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://buva.shop/api/auth/google/callback

# ---- order emails via Gmail (App Password, not your normal password) ----
GMAIL_USER=buva.fragrance@gmail.com
GMAIL_APP_PASSWORD=

# ---- optional ----
# Browser push notifications (one-line JSON of the Firebase service account)
FIREBASE_PROJECT_ID=buva-90d4b
FIREBASE_SERVICE_ACCOUNT_JSON=
# External RAG service for the assistant (falls back to the live catalogue when empty)
RAG_API_URL=
RAG_API_TOKEN=
